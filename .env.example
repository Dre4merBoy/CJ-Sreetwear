# ============================================================
# SALMAS · by CJ — Plantilla de variables de entorno
# ------------------------------------------------------------
# CÓMO USAR:
#   1. Copia este archivo y renómbralo a ".env"
#   2. Rellena los valores reales
#   3. El ".env" está en .gitignore: NUNCA se sube a GitHub
#
# ⚠️ IMPORTANTE — entiende esto:
#   En un sitio ESTÁTICO (solo navegador), lo que llega al
#   cliente NO es secreto: cualquiera lo puede ver. Por eso aquí
#   abajo separamos lo PÚBLICO (ok que se vea) de los SECRETOS
#   (que SOLO deben vivir en el servidor, nunca en el navegador).
# ============================================================

# ----- PÚBLICO (se puede exponer al navegador) -----

# Puerto del servidor de preview (server.js)
PORT=5173

# Número de WhatsApp de contacto. Es público por diseño: va en el
# botón que todos los clientes ven. Formato internacional sin "+".
WHATSAPP_NUMERO=521234567890


# ============================================================
# 🔒 SECRETOS — SOLO para cuando tengas un BACKEND
# ------------------------------------------------------------
# Estos NUNCA deben enviarse al navegador ni ponerse en archivos
# .js del frontend. Úsalos solo en código de servidor.
# (Descoméntalos y rellénalos cuando agregues backend/pagos.)
# ============================================================

# --- Pasarela de pago (ej. Stripe / MercadoPago) ---
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx

# --- Base de datos (donde vivirían datos de clientes) ---
# DATABASE_URL=postgresql://usuario:password@host:5432/salmas

# --- Sesiones / tokens ---
# JWT_SECRET=cadena-larga-y-aleatoria

# --- Correo (newsletter / confirmaciones) ---
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_USER=hola@salmas.cj
# SMTP_PASSWORD=xxxxxxxxxxxx
